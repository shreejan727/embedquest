# ============================================================
# EMBEDQUEST — environment variables template
# Copy this file to `.env` (local) or set these in Vercel
# (Project → Settings → Environment Variables).
#
# NEVER put the service-role key here — frontend env vars are
# PUBLIC. Only the anon/publishable key is safe in the browser.
# ============================================================

# Supabase project URL (Dashboard → Project Settings → API → Project URL)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase anon/public key (Dashboard → Project Settings → API → anon public)
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# MIAA — the real AI tutor (optional)
# Points the app to its server-side proxy function on Vercel.
# Leave empty to use the built-in offline rule-based teacher instead.
VITE_AI_ENDPOINT=/api/teacher

# SECURITY: the Gemini API key is NEVER a frontend variable!
# VITE_* values get baked into the public JS bundle — anyone could
# read them. Put the key ONLY in Vercel → Settings → Environment
# Variables as GEMINI_API_KEY; the serverless function
# frontend/api/teacher.mjs reads it at runtime.
# Optional: GEMINI_MODEL (default: gemini-2.5-flash-lite)
